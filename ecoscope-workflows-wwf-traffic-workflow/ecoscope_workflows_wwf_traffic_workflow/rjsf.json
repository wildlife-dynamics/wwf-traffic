    "load_traffic_csvs": {
      "additionalProperties": false,
      "properties": {
        "file_paths": {
          "items": {
            "type": "string"
          },
          "title": "File Paths",
          "type": "array",
          "description": "Paths to the CSV files to load and merge."
        }
      },
      "required": [
        "file_paths"
      ],
      "type": "object",
      "title": "Load Traffic CSV files"
    },
    "incident_species_colormap": {
      "additionalProperties": false,
      "properties": {
        "color_palette": {
          "anyOf": [
            {
              "$ref": "#/$defs/ColormapPalette"
            },
            {
              "$ref": "#/$defs/CustomPalette"
            }
          ],
          "default": {
            "type_": "palette",
            "name": "tab10"
          },
          "title": "Color Palette"
        }
      },
      "type": "object",
      "required": [],
      "title": "Select colormap to use for species and incidents"
    },
    "Map Zoom & Extent": {
      "type": "object",
      "description": "Calculate the geographic extent of the movement tracks and determine an appropriate zoom level and center point for the map. This ensures that all tracks are visible and well-framed when the map is rendered.",
      "ecoscope:task_group": true,
      "properties": {
        "zoom_to_envelope": {
          "additionalProperties": false,
          "properties": {
            "expansion_factor": {
              "default": 1.5,
              "title": "Expansion Factor",
              "type": "number",
              "description": "Factor to expand the bounding box (e.g., 1.2 = 20% larger)",
              "ecoscope:advanced": true
            }
          },
          "required": [],
          "type": "object",
          "title": ""
        }
      }
    }
  },
